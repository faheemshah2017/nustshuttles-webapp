<%- include('./partials/header') %>

  <body id="page-top">
    <div id="wrapper">
      <!-- Sidebar -->
      <%- include('./partials/sidebar') %>
        <!-- Sidebar -->
        <div id="content-wrapper" class="d-flex flex-column">
          <div id="content">
            <!-- TopBar -->
            <%- include('./partials/topbar') %>
              <!-- Topbar -->

              <!-- Container Fluid-->
              <div class="container-fluid" id="container-wrapper">
                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                  <h1 class="h3 mb-0 text-gray-800">Shuttles</h1>
                  <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="./">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Shuttles</li>
                  </ol>
                </div>
                <div class="row mb-3">
                  <div class="col-xl-12">
                    <button class="btn btn-primary mb-1" style="float: right;" onclick="addShuttleClick()"
                      data-toggle="modal" id="addShuttleBtn" data-target="#addShutteModal">Add +</button>
                  </div>
                </div>
                <!--Row-->
                <!-- Row -->
                <div class="row">
                  <!-- Datatables -->
                  <div class="col-lg-12">
                    <div class="card mb-4">
                      <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                        <h6 class="m-0 font-weight-bold text-primary">Shuttles List</h6>
                      </div>
                      <div class="table-responsive p-3">
                        <table class="table align-items-center table-flush table-hover" id="dataTableHover">
                          <thead class="thead-light">
                            <tr>
                              <th>Shuttle Id</th>
                              <th>Number</th>
                              <!-- <th>Locate</th> -->
                              <th>Action</th>
                            </tr>
                          </thead>
                          <tbody id="table"></tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
                <!--Row-->
                <!-- <div class="row mb-3">
                  <div class="col-lg-12">
                    <div id="map" style="height:480px;"></div>
                  </div>
                </div> -->
                <!-- Modal Logout -->
                <div class="modal fade" id="addShutteModal" tabindex="-1" role="dialog"
                  aria-labelledby="exampleModalLabelLogout" aria-hidden="true">
                  <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabelLogout">Add Shuttle</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                          <span aria-hidden="true">&times;</span>
                        </button>
                      </div>
                      <div class="modal-body">
                        <form id="data_form">
                          <input id="rowId" name="rowId" style="display: none;">
                          <div class="form-group">
                            <label>Shuttle ID</label>
                            <input type="number" class="form-control" required name="deviceId" id="deviceId"
                              placeholder="Enter Device ID">
                          </div>
                          <div class="form-group">
                            <label>Shuttle Number</label>
                            <input type="number" class="form-control" required name="shuttleNumber" id="shuttleNumber"
                              placeholder="Enter Shuttle Number">
                          </div>
                          <div class="form-group">
                            <label>Shuttle Route</label>
                            <div class="row">
                              <div class="col-md-3">
                                <select type="text" required id="shuttleRoute" class="form-control">
                                  <% routes.forEach(route=> {%>
                                    <option style="background:white;color:black" value="<%=route._id%>">
                                      <%=route.routeTitle%>-<%=route.pathNumber%>
                                    </option>
                                    <% }); %>
                                </select>
                              </div>
                              <div class="col-md-3">
                                <input type="time" class="form-control" required id="timeFrom">
                              </div>
                              <div class="col-md-3">
                                <input type="time" class="form-control" required id="timeTo">
                              </div>
                              <div class="col-md-3">
                                <span class="btn btn-outline-primary btn-block" onclick="addRoute()" id="addRouteBtn">Add</span>
                              </div>
                            </div>
                            
                            <div id="routesList">
                            </div>
                          </div>
                        </form>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-outline-primary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="addBtn" onclick="addShuttle()">Add</button>
                        <button type="submit" class="btn btn-primary" id="updateBtn"
                          onclick="updateShuttle()">Update</button>
                      </div>
                    </div>
                  </div>
                </div>

              </div>
              <!---Container Fluid-->
          </div>
          <!-- Footer -->
          <%- include('./partials/footer') %>
            <!-- Footer -->
        </div>
    </div>

    <!-- Scroll to top -->
    <a class="scroll-to-top rounded" href="#page-top">
      <i class="fas fa-angle-up"></i>
    </a>


    <%- include('./partials/plugins') %>
  </body>

  <script src="https://unpkg.com/@google/markerclustererplus@4.0.1/dist/markerclustererplus.min.js"></script>
  <!-- <script
    src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDpx_pUdrVXPkpH8d36RDyvIY1HrEA082E &callback=initMap&libraries=&v=weekly"
    async>
  </script> -->
  <script>
    routes = <%- JSON.stringify(routes); %>;
    shuttles = <%- JSON.stringify(shuttles); %>;
  </script>
  <script src="/js/shuttles.js"></script>

  </html>