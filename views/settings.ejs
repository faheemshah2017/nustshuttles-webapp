<% include ./partials/header %>

  <body id="page-top">
    <div id="wrapper">
      <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
          <!-- TopBar -->
          <% include ./partials/topbar %>
            <!-- Topbar -->
            <!-- Container Fluid-->

            <div class="container-fluid" id="container-wrapper">
              <!-- Row -->
              <div class="row">
                <div class="col-lg-6">
                  <div class="card mb-4">
                    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                      <h6 class="m-0 font-weight-bold text-primary">Alerts Settings</h6>
                    </div>
                    <div class="card-body">
                      <form method="POST" action="/settings/update">
                        <h6>Receivers Emails</h6>
                        <div class="form-group row">
                          <div class="col-sm-9">
                            <input class="form-control" name="email_receivers" id="email_receivers"
                              placeholder="You can enter multiple emails using comma seperation">
                          </div>
                          <div class="col-sm-3">
                            <button type="button" id="toggle_email" class="form-control btn-block mb-1"></button>
                          </div>
                        </div>
                        <h6>Mobile Phone Alerts</h6>
                        <div class="form-group row">
                          <div class="col-sm-9">
                            <input type="text" class="form-control" name="mobile_receivers" id="mobile_receivers"
                              placeholder="Enter mobile number here">
                          </div>
                          <div class="col-sm-3">
                            <button type="button" id="toggle_mobile"
                              class="form-control btn-outline-primary btn-block mb-1"></button>
                          </div>
                        </div>
                        <h6>Alerts Interval in Minutes</h6>
                        <div class="form-group row">
                          <div class="col-sm-4">
                            <input type="number" class="form-control" name="alert_interval" id="alert_interval"
                              placeholder="Enter interval in minutes">
                          </div>
                        </div>
                        <div class="form-group row">
                          <div class="col-sm-9">
                            <button type="submit" class="btn btn-primary">Save</button>
                          </div>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
                <div class="col-lg-6">
                  <div class="card mb-4">
                    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                      <h6 class="m-0 font-weight-bold text-primary">Token Settings</h6>
                      <button onclick="generateToken()" class="btn btn-outline-primary">Generate Random Token</button>
                    </div>
                    <div class="card-body">
                      <form method="POST" action="/save/token">
                        <h6>Paste Token Here</h6>
                        <div class="form-group row">
                          <div class="col-sm-12">
                            <textarea type="text" class="form-control" rows="4" name="token" id="token"
                              placeholder="Please add token to be saved in Database. \n this token will be used as auth to send device data"></textarea>
                          </div>
                        </div>
                        <div class="form-group row">
                          <div class="col-sm-12">
                            <button type="submit" class="btn btn-primary">Save</button>
                          </div>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
              <!--Row-->
              <!-- Row -->
              <div class="row">
                <!-- Datatables -->
                <!-- Datatables -->
                <div class="col-lg-12">
                  <div class="card mb-4">
                    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                      <h6 class="m-0 font-weight-bold text-primary">Users List</h6>
                    </div>
                    <div class="table-responsive p-3">
                      <table class="table align-items-center table-flush table-hover" id="dataTableHover">
                        <thead class="thead-light">
                          <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Actions</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% users.forEach(user=> {%>
                            <tr>
                              <td>
                                <%=user.firstName%> <%=user.lastName%>
                              </td>
                              <td>
                                <%=user.email%>
                              </td>
                              <td>
                                <% if(user.role!="manager" ){ %>
                                  <% if(!user.active){ %><button type="button" id="<%=user._id%>"
                                      onclick="toggleUser(this,true)"
                                      class="btn btn-outline-success mb-1">Activate</button>
                                    <% }else{%><button type="button" id="<%=user._id%>" onclick="toggleUser(this,false)"
                                        class="btn btn-outline-warning mb-1">Deactivate</button>
                                      <% }%>
                                        <% }%>
                              </td>
                            </tr>
                            <%});%>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
              <!--Row-->
              <!-- Row -->
              <div class="row">
                <!-- Datatables -->
                <!-- Datatables -->
                <div class="col-lg-12">
                  <div class="card mb-4">
                    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                      <h6 class="m-0 font-weight-bold text-primary">Logs</h6>
                    </div>
                    <div class="p-3">
                      <div class="card p-3" style="background-color: black;color: white;">
                        <% logs.forEach(log=> {%>
                          <p>
                            <%=log.message%>
                          </p>
                          <%});%>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <!--Row-->

            </div>
            <!---Container Fluid-->
        </div>

        <!-- Footer -->
        <% include ./partials/footer %>
          <!-- Footer -->
      </div>
    </div>

    <!-- Scroll to top -->
    <a class="scroll-to-top rounded" href="#page-top">
      <i class="fas fa-angle-up"></i>
    </a>


    <% include ./partials/plugins %>
      <!-- Page level plugins -->
      <script src="vendor/datatables/jquery.dataTables.min.js"></script>
      <script src="vendor/datatables/dataTables.bootstrap4.min.js"></script>

      <!-- Page level custom scripts -->
      <script>
        settings = <%- JSON.stringify(settings) %>
          $(document).ready(function () {
            $('#email_receivers').val(settings.email_receivers);
            $('#mobile_receivers').val(settings.mobile_receivers);
            $('#alert_interval').val(settings.alert_interval);
            $('#token').val(settings.token);
            if (settings.email_alerts) {
              $('#toggle_email').html("Disable");
              $('#toggle_email').addClass("btn-outline-warning");
            }
            else {
              $('#toggle_email').html("Enable");
              $('#toggle_email').addClass("btn-outline-primary");
            }
            if (settings.mobile_alerts) {
              $('#toggle_mobile').html("Disable");
              $('#toggle_mobile').addClass("btn-outline-warning");
            }
            else {
              $('#toggle_mobile').html("Enable");
              $('#toggle_email').addClass("btn-outline-primary");
            }
            $("#toggle_email").click(() => {
              $.ajax({
                url: "/settings/toggle/email",
                data: JSON.stringify({}),
                cache: false,
                processData: false,
                contentType: 'application/json',
                type: 'PUT',
                success: function (dataofconfirm) {
                  location.reload()
                }
              });
            })
            $("#toggle_mobile").click(() => {
              $.ajax({
                url: "/settings/toggle/mobile",
                data: JSON.stringify({}),
                cache: false,
                processData: false,
                contentType: 'application/json',
                type: 'PUT',
                success: function (dataofconfirm) {
                  location.reload()
                }
              });
            })
            $('#dataTable').DataTable(); // ID From dataTable 
            $('#dataTableHover').DataTable(); // ID From dataTable with Hover
          });

        function toggleUser(user, value) {
          console.log(user.id, value)
          $.ajax({
            url: "/users/activate/" + user.id,
            data: JSON.stringify({ active: value }),
            cache: false,
            processData: false,
            contentType: 'application/json',
            type: 'PUT',
            success: function (dataofconfirm) {
              location.reload();
            }
          });
        }

        var rand = function () {
          return Math.random().toString(36).substr(2); // remove `0.`
        };

        function token() {
          return rand() + rand(); // to make it longer
        };

        function generateToken() {
          $("#token").val(token())
          console.log(token());
        }
      </script>

  </body>

  </html>