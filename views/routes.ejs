      // });
    };

    const flightPath = []
    var lastRoute = 0;
    function changeRoute(e) {
      selectRoute(e.target.value)
    }
    function selectRoute(routeNumber) {
      let flightPlanCoordinates = routes[0].paths[routeNumber].path;
      flightPath[routeNumber] = new google.maps.Polyline({
        path: flightPlanCoordinates,
        geodesic: true,
        strokeColor: "#224879",
        strokeOpacity: 1.0,
        strokeWeight: 2,
      });
      try {
        flightPath[lastRoute].setMap(null);
      }
      catch (e) { }
      flightPath[routeNumber].setMap(map);
      lastRoute = routeNumber
    }

  </script>

  </html>