<%- include('./partials/header') %>

  <body id="page-top">
    <div id="wrapper">
      <!-- Sidebar -->
      <%- include('./partials/sidebar') %>
        <!-- Sidebar -->
        <div id="content-wrapper" class="d-flex flex-column">
          <div id="content">
            <!-- TopBar -->
            <%- include('./partials/topbar') %>
              <!-- Topbar -->

              <!-- Container Fluid-->
              <div class="container-fluid" id="container-wrapper">
                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                  <h1 class="h3 mb-0 text-gray-800">Routes</h1>
                  <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="./">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Routes</li>
                  </ol>
                </div>
                
                <!-- Row -->
                <div class="row">
                  <!-- Datatables -->
                  <div class="col-lg-12">
                    <div class="card mb-4">
                      <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                        <h6 class="m-0 font-weight-bold text-primary">Routes List</h6>
                      </div>
                      <div class="table-responsive p-3">
                        <table class="table align-items-center table-flush table-hover" id="dataTableHover">
                          <thead class="thead-light">
                            <tr>
                              <th>Route Title</th>
                              <th>Route Number</th>
                              <th>Path Number</th>
                              <th>Route Length</th>
                              <th>Action</th>
                            </tr>
                          </thead>
                          <tbody id="table"></tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
                <!--Row-->
                <div class="row mb-3">
                  <div class="col-xl-12">
                    <select type="text" class="btn btn-primary mb-1" onchange="changeRoute(event)">
                      <option style="background:white;color:black">Select Route</option>
                      <% routes.forEach(route=> {%>
                        <option style="background:white;color:black" value="<%=route._id%>"><%=route.routeTitle%>
                            -<%=route.pathNumber%>
                        </option>
                        <% }); %>
                    </select>
                    <input type="checkbox" id="enableStopsCheckbox" name="enableStopsCheckbox" value="enableStopsCheckbox">
                    <button class="btn btn-primary mb-1" style="float: right;display: none;" data-toggle="modal"
                      id="saveRouteBtn" data-target="#addRouteModal">Save</button>
                    <button class="btn btn-primary mb-1" style="float: right;display: none;" id="cancelRouteBtn"
                      onclick="cancelRoute()">Cancel</button>

                    <button class="btn btn-primary mb-1" style="float: right;display: block;" id="addRouteBtn"
                      onclick="addRoute()">Add +</button>

                  </div>
                  <div class="col-lg-12">
                    <div id="map" style="height:800px;"></div>
                  </div>
                </div>
                <!--Row-->

                <!-- Modal Logout -->
                <div class="modal fade" id="addRouteModal" tabindex="-1" role="dialog"
                  aria-labelledby="exampleModalLabelLogout" aria-hidden="true">
                  <div class="modal-dialog" role="document">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabelLogout">Add Route</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                          <span aria-hidden="true">&times;</span>
                        </button>
                      </div>
                      <div class="modal-body">
                        <form id="data_form">
                          <input id="rowId" name="rowId" style="display: none;">
                          <div class="form-group">
                            <label>Route Title</label>
                            <input type="text" class="form-control" required name="routeTitle" id="routeTitle"
                              placeholder="Enter Route Title">
                          </div>
                          <div class="form-group">
                            <label>Route Number</label>
                            <input type="number" class="form-control" required name="routeNumber" id="routeNumber"
                              placeholder="Enter Route Number">
                          </div>
                          <div class="form-group">
                            <label>Path Number</label>
                            <input type="number" class="form-control" required name="pathNumber" id="pathNumber"
                              placeholder="Enter Path Number">
                          </div>
                          <!-- <div class="form-group">
                            <label>Time From</label>
                            <input type="time" class="form-control" required name="timeFrom" id="timeFrom">
                          </div>
                          <div class="form-group">
                            <label>Time To</label>
                            <input type="time" class="form-control" required name="timeTo" id="timeTo">
                          </div> -->
                        </form>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-outline-primary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="addBtn" onclick="submitRoute()">Add</button>
                        <button type="submit" class="btn btn-primary" id="updateBtn" onclick="updateRoute()">Update</button>
                      </div>
                    </div>
                  </div>
                </div>

              </div>
              <!---Container Fluid-->
          </div>
          <!-- Footer -->
          <%- include('./partials/footer') %>
            <!-- Footer -->
        </div>
    </div>

    <!-- Scroll to top -->
    <a class="scroll-to-top rounded" href="#page-top">
      <i class="fas fa-angle-up"></i>
    </a>


    <%- include('./partials/plugins') %>
  </body>

  <script src="https://unpkg.com/@google/markerclustererplus@4.0.1/dist/markerclustererplus.min.js"></script>
  <script>
    routes = <%- JSON.stringify(routes); %>;
  </script>
  <script src="/js/routes.js"></script>

  <script
    src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDpx_pUdrVXPkpH8d36RDyvIY1HrEA082E &callback=initMap&libraries=&v=weekly"
    async></script>
  </html>