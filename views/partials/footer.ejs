<script>
  $.ajax({
    url: "/newAlerts",
    cache: false,
    processData: false,
    type: "GET",
    success: function (data) {
      alerts = "";
      data.forEach(e => {
        let date = new Date(e.time)
        date = date.toLocaleDateString("en", { hours:'numaric',month: "short",day: 'numeric', year: 'numeric'})
        alerts +=`
          <a class="dropdown-item d-flex align-items-center" href="#">
            <div class="mr-3">
              <div class="icon-circle bg-danger">
                <i class="fas fa-bell text-white"></i>
              </div>
            </div>
            <div>
              <div class="small text-gray-500">${date}</div>
              <span class="font-weight-bold">${e.message}</span>
            </div>
          </a>`
      });
      document.getElementById("alerts").innerHTML = alerts;
    },
  });
</script>
