<%- include('./partials/header') %>

  <body id="page-top">
    <div id="wrapper">
      <!-- Sidebar -->
      <%- include('./partials/sidebar') %>
        <!-- Sidebar -->
        <div id="content-wrapper" class="d-flex flex-column">
          <div id="content">
            <!-- TopBar -->
            <%- include('./partials/topbar') %>
              <!-- Topbar -->

              <!-- Container Fluid-->
              <div class="container-fluid" id="container-wrapper">
                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                  <h1 class="h3 mb-0 text-gray-800">Shuttle Status
                    <button onclick="loadStatus()" id="refreshStatusBtn" class="btn btn-primary" style="height: 41px;margin-top: 1px;"> &#x27f3; Refresh</button>
                  </h1>
                  <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="./">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Shuttle Status</li>
                  </ol>
                </div>
                <!-- Row -->
                <div class="row">
                  <div class="col-lg-12">
                    <div class="card mb-4">
                      <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                        <h6 class="m-0 font-weight-bold text-primary">Last Data Received Per Shuttle</h6>
                        <span class="small text-muted" id="lastRefreshed"></span>
                      </div>
                      <div class="table-responsive p-3">
                        <table class="table align-items-center table-flush table-hover">
                          <thead class="thead-light">
                            <tr>
                              <th>Shuttle #</th>
                              <th>Device ID</th>
                              <th>Last Data Time</th>
                              <th>Time Since</th>
                              <th>Status</th>
                            </tr>
                          </thead>
                          <tbody id="statusTable">
                            <tr>
                              <td colspan="5" class="text-center text-muted">Loading&hellip;</td>
                            </tr>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
                <!--Row-->

              </div>
              <!---Container Fluid-->
          </div>
          <%- include('./partials/plugins') %>
          <!-- Footer -->
          <%- include('./partials/footer') %>
            <!-- Footer -->
        </div>
    </div>

    <!-- Scroll to top -->
    <a class="scroll-to-top rounded" href="#page-top">
      <i class="fas fa-angle-up"></i>
    </a>

  </body>

  <script src="/js/shuttle_status.js"></script>
  </html>
